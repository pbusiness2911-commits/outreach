# Postgres connection. Railway sets this automatically when you add a Postgres database.
# Leave empty locally to use a built-in database stored in ./.data
DATABASE_URL=

# Password for logging in to the dashboard
ADMIN_PASSWORD=change-me

# Random long string used to sign login cookies and unsubscribe links
APP_SECRET=replace-with-a-long-random-string

# Public URL of the app (used in unsubscribe links), e.g. https://outreach.up.railway.app
PUBLIC_URL=http://localhost:3000

# Google service account key (the whole JSON file contents, on one line).
# See SETUP.md, step 2.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: MillionVerifier API key for email verification. Without it, a basic
# check (syntax, domain mail server, disposable and role addresses) is used.
MILLIONVERIFIER_API_KEY=

# Set to "true" to never actually send (emails are logged instead). Use for testing.
DRY_RUN=false

PORT=3000
